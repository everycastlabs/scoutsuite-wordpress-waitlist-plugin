# Optional. Video walkthroughs and `docker compose up` fill these automatically
# when a local Scout Suite API is running (E2E_TEST_MODE). You only set them by
# hand to point at a specific org.
#
# Local API from Docker: host.docker.internal is the machine running wrangler.
# Walkthrough pipeline uses 8790 instead of 8787.

SCOUTSUITE_ORG_ID=
SCOUTSUITE_WAITLIST_GROUP_ID=
SCOUTSUITE_API_KEY=
SCOUTSUITE_API_BASE_URL=http://host.docker.internal:8787
SCOUTSUITE_AUTO_SEED=1

# Skills for Life child theme (Leaflet + postcodes.io), cloned at seed time.
SFL_CHILD_THEME_REPO=https://github.com/everycastlabs/sfl-wordpress-child-theme
SFL_CHILD_THEME_REF=main
